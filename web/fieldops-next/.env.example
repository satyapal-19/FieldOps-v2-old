# Copy to .env.local (git-ignored).
# Where the Next.js server reaches the NestJS API (no trailing slash). Server-side only: the
# browser talks to this app, which forwards /api/v1/* with the session from httpOnly cookies.
API_INTERNAL_URL=http://localhost:3000
# Mark session cookies Secure (needs HTTPS). Defaults to true when NODE_ENV=production.
# COOKIE_SECURE=true
