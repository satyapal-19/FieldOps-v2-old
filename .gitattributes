# Normalise line endings in the repo; Windows scripts keep CRLF on checkout.
* text=auto
*.bat text eol=crlf
*.cmd text eol=crlf
*.ps1 text eol=crlf
*.sh  text eol=lf

# Binary files
*.png binary
*.jpg binary
*.jpeg binary
*.gif binary
*.ico binary
*.jar binary
*.pdf binary
*.docx binary
*.onnx binary
*.tflite binary
