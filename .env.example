# Docker Compose settings for LOCAL databases only. Copy to .env (git-ignored).
# Use the same user/password in backend/.env.development and backend/.env.test.
POSTGRES_USER=fieldops
POSTGRES_PASSWORD=change-me-local

# Oracle XE (optional, `docker compose --profile oracle up -d oracle`)
ORACLE_PASSWORD=change-me-local
ORACLE_APP_PASSWORD=change-me-local
