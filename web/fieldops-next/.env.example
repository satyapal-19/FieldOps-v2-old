# Copy to .env.local (git-ignored).
# Where the Next.js server reaches the NestJS API (no trailing slash). Server-side only: the
# browser talks to this app, which forwards /api/v1/* with the session from httpOnly cookies.
API_INTERNAL_URL=http://localhost:3000
# Mark session cookies Secure (needs HTTPS). Defaults to true when NODE_ENV=production.
# COOKIE_SECURE=true
# Map tiles (OpenStreetMap only). Default: the public OSM server; point this at the backend's
# offline SMKMC tile pack when it ships (Phase 4).
# NEXT_PUBLIC_TILE_URL=https://tile.openstreetmap.org/{z}/{x}/{y}.png

# Production: run ONE instance bound to this machine only (the standalone server reads
# HOSTNAME and PORT), so only IIS can reach it and forwarded client addresses are trusted.
# One instance also keeps refresh-token rotation in one process (see src/server/session.ts).
# HOSTNAME=127.0.0.1
# PORT=3001
